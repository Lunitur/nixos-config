 	if (substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
-	    params_channels(params) == 2 && component->name_prefix) {
+	    params_channels(params) == 2 && component->name_prefix &&
+	    !dmi_match(DMI_BOARD_NAME, "HN7306EAC")) {
 		const char *idx_str = strrchr(component->name_prefix, '-');
 		unsigned long idx;
 
