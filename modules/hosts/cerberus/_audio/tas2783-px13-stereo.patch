+static int tas_px13_wait_clear(struct sdw_slave *slave, u32 reg, u8 mask)
+{
+	unsigned int timeout_us = max(slave->prop.ch_prep_timeout, 1U) * USEC_PER_MSEC;
+	int val, ret;
+
+	ret = read_poll_timeout(sdw_read_no_pm, val, val < 0 || !(val & mask),
+				1000, timeout_us, false, slave, reg);
+	return val < 0 ? val : ret;
+}
+
+static int tas_px13_set_prepare(struct sdw_slave *slave, struct sdw_prepare_ch *ch, bool prepare)
+{
+	int ret;
+
+	ret = sdw_write_no_pm(slave, SDW_DPN_PREPARECTRL(ch->num), prepare ? ch->ch_mask : 0);
+	if (ret)
+		return ret;
+
+	return tas_px13_wait_clear(slave, SDW_DPN_PREPARESTATUS(ch->num), ch->ch_mask);
+}
+
+static int tas_px13_prepare_right(struct sdw_slave *slave, struct sdw_prepare_ch *ch)
+{
+	u32 actual_ps = SDW_SDCA_CTL(1, TAS2783_SDCA_ENT_PDE23, SDCA_CTL_PDE_ACTUAL_PS, 0);
+	int ret;
+
+	/* Read the peripheral directly: PS0 may lag the power request. */
+	ret = tas_px13_wait_clear(slave, actual_ps, 0xff);
+	if (ret)
+		return ret;
+
+	ret = tas_px13_set_prepare(slave, ch, true);
+	if (ret != -ETIMEDOUT)
+		return ret;
+
+	/* Give the stuck port a fresh prepare edge. */
+	ret = tas_px13_set_prepare(slave, ch, false);
+	if (ret)
+		return ret;
+
+	return tas_px13_set_prepare(slave, ch, true);
 }
 
