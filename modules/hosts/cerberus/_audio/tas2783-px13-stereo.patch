 #include <linux/unaligned.h>
 #include <linux/crc32.h>
+#include <linux/dmi.h>
 #include <linux/efi.h>
 #include <linux/err.h>
 #include <linux/firmware.h>
@@ -1017,8 +1018,10 @@
 	 * from the amp's position in the codec order of the DAI link, which
 	 * on these boards matches the prefix numbering.
 	 */
